{
  "name": "irminsul-atlas",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0 <25",
    "npm": ">=11 <12"
  },
  "packageManager": "npm@11.19.0",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "validate": "npm run validate:code && npm run content:evidence",
    "validate:code": "npm run format:check && npm run lint && npm run check && npm test && npm run build",
    "content:acquire": "node scripts/import/cli.ts acquire",
    "content:import": "node scripts/import/cli.ts import",
    "content:validate": "node scripts/import/cli.ts validate",
    "content:diff": "node scripts/import/cli.ts diff",
    "content:promote": "node scripts/import/cli.ts promote",
    "content:evidence": "node scripts/import/cli.ts evidence",
    "content:impact": "node scripts/import/cli.ts impact",
    "content:traveler": "node scripts/research/build-traveler-corpus.ts && prettier --write content/editorial/corpora/viajero.json",
    "content:coverage": "node scripts/research/coverage-inventory.ts && prettier --write content/editorial/genshin-coverage.json docs/validation/n08-inventario-cobertura-2026-10-05.md"
  },
  "dependencies": {
    "@astrojs/react": "7.0.0",
    "astro": "7.3.5",
    "d3-scale": "4.0.2",
    "d3-selection": "3.0.0",
    "d3-zoom": "3.0.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@axe-core/playwright": "4.13.0",
    "@eslint/js": "10.0.1",
    "@types/d3-scale": "4.0.9",
    "@types/d3-selection": "3.0.12",
    "@types/d3-zoom": "3.0.8",
    "@types/node": "24.13.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "10.11.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "jsdom": "30.1.1",
    "playwright-core": "1.63.0",
    "prettier": "3.9.9",
    "prettier-plugin-astro": "1.1.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.1",
    "vitest": "5.0.1"
  }
}
