{
  "eras": [
    {
      "id": "era-mundo-elemental",
      "name": "Mundo elemental",
      "description": "Antes del orden humano. Antigüedad absoluta desconocida."
    },
    {
      "id": "era-orden-celestial",
      "name": "Orden celestial",
      "description": "Conquista y adaptación del mundo; las cifras del libro pertenecen a su propia cuenta."
    },
    {
      "id": "era-rupturas-antiguas",
      "name": "Rupturas antiguas",
      "description": "Guerras, pilares y civilizaciones desaparecidas. No todos los desastres fueron simultáneos."
    },
    {
      "id": "era-historias-regionales",
      "name": "Trayectorias regionales",
      "description": "Recorridos de larga duración que se solapan con el orden de los Siete. Su posición de lectura no sincroniza regiones ni fija el final de cada historia."
    },
    {
      "id": "era-mundo-siete",
      "name": "Mundo de los Siete",
      "description": "Consolidación del sistema y trayectorias independientes; persisten herencias anteriores."
    },
    {
      "id": "era-umbral-gemelos",
      "name": "Umbral de los gemelos",
      "description": "Khaenri’ah y llegada de los gemelos. Visitas, despertares y separación no son un único acontecimiento."
    },
    {
      "id": "era-cierre-cataclismo",
      "name": "Cierre: Cataclismo",
      "description": "Cierre contextual fuera del límite estricto de llegada. No incluye el viaje jugable ni reconstruye los cinco siglos posteriores."
    }
  ],
