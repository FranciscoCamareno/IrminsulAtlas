---
import BaseLayout from '../layouts/BaseLayout.astro';
import TimelineExplorer from '../components/explorer/TimelineExplorer';
import { loadSiteContent, lorePreviewEnabled } from '../content/preview';

const dataset = await loadSiteContent();
---

<BaseLayout immersive preview={lorePreviewEnabled}>
  <TimelineExplorer dataset={dataset} client:load />
</BaseLayout>
