---
import BaseLayout from '../../layouts/BaseLayout.astro';
import DossierReader from '../../components/DossierReader';
import { loadDossierDocuments, dossierFiles } from '../../content/dossier';
export async function getStaticPaths() {
  return (await loadDossierDocuments()).map((document) => ({
    params: { document: document.id },
    props: { id: document.id, title: document.title },
  }));
}
const { id, title } = Astro.props;
---

<BaseLayout dossier>
  <nav class="dossier-navigation" aria-label="Documentos del dossier">
    {dossierFiles.map((item) => (
      <a
        href={'/dossier/' + item.id + '/'}
        aria-current={item.id === id ? 'page' : undefined}
      >
        {item.title}
      </a>
    ))}
  </nav>
  <article class="dossier-document">
    <h1>{title}</h1>
    <DossierReader id={id} client:load />
    <noscript>
      <p>
        El documento completo se muestra según tu progreso y necesita JavaScript
        para comprobarlo.
      </p>
    </noscript>
  </article>
</BaseLayout>
