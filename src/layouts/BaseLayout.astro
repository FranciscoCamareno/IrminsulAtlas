---
import '../styles/tokens.css';
import '../styles/global.css';
import '../styles/timeline.css';
import '../styles/skin.css';

interface Props {
  immersive?: boolean;
  preview?: boolean;
  dossier?: boolean;
}
const { immersive = false, preview = false, dossier = false } = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta
      name="description"
      content={
        dossier
          ? 'Historia antigua de Teyvat: acontecimientos, personajes, lugares e incertidumbres.'
          : 'Archivo para explorar acontecimientos, fuentes e incertidumbre histórica.'
      }
    />
    <title>{dossier ? 'Irminsul Atlas · Historia antigua de Teyvat' : preview ? 'Irminsul Atlas · Vista previa de Genshin Impact' : 'Irminsul Atlas · Archivo de demostración'}</title>
  </head>
  <body class:list={{ 'atlas-page': immersive }}>
    <a class="skip-link" href="#main">
      Saltar al contenido
    </a>
    {!immersive && (
      <header class="site-header">
        <a href="/" class="brand">
          Irminsul <span>Atlas</span>
        </a>
        <span class="metadata">
          {dossier
            ? 'Historia antigua'
            : preview
              ? 'Vista previa temporal'
              : 'Archivo de demostración'}
        </span>
      </header>
    )}
    <main id="main" tabindex="-1" class:list={{ 'atlas-main': immersive }}>
      {!immersive && !dossier && (
        <div class="demo-notice">
          <strong>
            {preview
              ? 'Vista previa de Genshin Impact'
              : 'Datos de demostración'}
          </strong>
          <p>
            {preview
              ? 'Textos reales del juego con distribución y conexiones provisionales para probar el diseño. Puede contener spoilers.'
              : 'El Archivo de la Bruma es ficticio. Sus acontecimientos, personajes y fuentes no representan lore de Genshin Impact.'}
          </p>
        </div>
      )}
      <slot />
    </main>
    {!immersive && (
      <footer class="site-footer">
        <p>
          <a href="/">Volver a la cronología</a>
        </p>
        <p>
          Los filtros de spoilers protegen la lectura; los archivos de un sitio
          estático siguen siendo públicos.
        </p>
      </footer>
    )}
  </body>
</html>
